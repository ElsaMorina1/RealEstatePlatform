<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Real Estate Platform</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css" />

</head>

<body>

   @*@ <div class="loader">

    <div class="spinner"></div>

</div>*@

    <nav class="navbar navbar-expand-lg navbar-dark">

        <div class="container">

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">

                <i class="fa-solid fa-building"></i>
                RealEstate

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarNav">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            Home

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Property"
                           asp-action="Index">

                            Properties

                        </a>

                    </li>

                   @* @if(User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Logout">

                                Logout

                            </a>

                        </li>
                    }*@
                   
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">

                                Login

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Register">

                                Register

                            </a>

                        </li>
                    

                    @if(User.IsInRole("Admin"))
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Admin"
                               asp-action="Dashboard">

                                Admin

                            </a>

                        </li>
                    }

                </ul>

                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
    <button type="submit" class="nav-link btn btn-link text-dark">Log out</button>
</form>
            </div>
            <button id="darkModeToggle"
        class="btn btn-outline-light">

    Dark Mode

</button>

        </div>

    </nav>

    @RenderBody()

    <footer class="footer">

        <div class="container text-center">

            <h3>Real Estate Platform</h3>

            <p>
                Modern Property Management System
            </p>

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

  

</body>

</html>


