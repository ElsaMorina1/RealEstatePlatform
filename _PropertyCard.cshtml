@model IEnumerable<RealEstatePlatform.Models.Property>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card property-card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">

                <!-- Fotoja e Pronës -->
                <img src="@(!string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : "https://via.placeholder.com/400x250")"
                     class="card-img-top" style="height: 220px; object-fit: cover;"
                     alt="@item.Title">

               

               
                <!-- Të dhënat e Pronës -->
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h4 class="fw-bold text-truncate mb-1">@item.Title</h4>
                        <p class="text-muted small mb-2">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>@(item.City ?? "N/A") - @item.Address
                        </p>

                        <!-- Paneli i Detajeve -->
                        <div class="detailsPanel bg-light p-3 rounded-3 mb-3 border">
                            <div class="row g-2 small text-secondary">
                                <div class="col-6">
                                    <strong class="text-dark">Category:</strong> @(item.Category?.Name ?? "N/A")
                                </div>
                                <div class="col-6">
                                    <strong class="text-dark">Bathrooms:</strong> @item.Bathrooms
                                </div>
                                <div class="col-6">
                                    <strong class="text-dark">Surface:</strong> @item.Area m²
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div class="mt-2 pt-2 border-top small">
                                    <strong class="text-dark">Description:</strong>
                                    <p class="text-muted mb-0 mt-1 text-truncate">@item.Description</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Butoni i Detajeve -->
                    <a asp-controller="Property" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary rounded-3 w-100 fw-semibold">
                        View Details
                    </a>
                </div>

            </div>
        </div>
    }
</div>