@model RealEstatePlatform.Models.HomeViewModel

@{
    ViewData["Title"] = "login2";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="dashboard-container d-flex">
    <!-- Sidebar -->
    <aside class="sidebar p-3">
        <div class="brand d-flex align-items-center mb-4 ps-2">
            <i class="bi bi-building-fill text-primary fs-3 me-2"></i>
            <h4 class="fw-bold m-0">RealEstate</h4>
        </div>
        <nav class="nav flex-column gap-2">
            <a class="nav-link active" asp-controller="Account" asp-action="login2">
                <i class="bi bi-grid-1x2-fill me-2"></i> Dashboard
            </a>
            <a class="nav-link" asp-controller="Property" asp-action="Index">
                <i class="bi bi-houses-fill me-2"></i> Properties
            </a>
            <a class="nav-link" asp-controller="Property" asp-action="Favorites">
                <i class="bi bi-heart-fill me-2"></i> Favorites
            </a>
            <a class="nav-link" asp-controller="Account" asp-action="Profile">
                <i class="bi bi-person-circle me-2"></i> Profile
            </a>
            <hr class="text-secondary my-2" />
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="nav-link text-danger border-0 bg-transparent w-100 text-start">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </button>
            </form>
        </nav>
    </aside>

    <!-- Content Area -->
    <main class="main-content flex-grow-1 p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold m-0">Welcome, @(User.Identity?.Name ?? "User")! 👋</h2>
                <p class="text-muted m-0">Manage your property listings and view statistics easily.</p>
            </div>
            <a asp-controller="Property" asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Add Property
            </a>
        </div>

        <!-- Stats Grid -->
        <div class="row g-3 mb-5">
            <div class="col-md-4">
                <div class="stat-card p-3 d-flex align-items-center justify-content-between shadow-sm rounded-4 bg-white">
                    <div>
                        <span class="text-muted small fw-bold">MY PROPERTIES</span>
                        <h3 class="fw-bold m-0 mt-1">@(Model?.Properties?.Count() ?? 0)</h3>
                    </div>
                    <div class="stat-icon bg-primary-subtle text-primary rounded-circle p-3">
                        <i class="bi bi-house-door fs-4"></i>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-card p-3 d-flex align-items-center justify-content-between shadow-sm rounded-4 bg-white">
                    <div>
                        <span class="text-muted small fw-bold">FAVORITES</span>
                        <h3 class="fw-bold m-0 mt-1">0</h3>
                    </div>
                    <div class="stat-icon bg-danger-subtle text-danger rounded-circle p-3">
                        <i class="bi bi-heart fs-4"></i>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-card p-3 d-flex align-items-center justify-content-between shadow-sm rounded-4 bg-white">
                    <div>
                        <span class="text-muted small fw-bold">TOTAL LISTINGS</span>
                        <h3 class="fw-bold m-0 mt-1">@(Model?.Properties?.Count() ?? 0)</h3>
                    </div>
                    <div class="stat-icon bg-success-subtle text-success rounded-circle p-3">
                        <i class="bi bi-layers fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Properties Grid -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold m-0">My Latest Properties</h4>
            <a asp-controller="Property" asp-action="Index" class="text-primary text-decoration-none fw-semibold">View All <i class="bi bi-arrow-right"></i></a>
        </div>

        <div class="row g-4">
            @if (Model?.Properties != null && Model.Properties.Any())
            {
                @foreach (var item in Model.Properties)
                {
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                            <div class="position-relative">
                                <img src="@(!string.IsNullOrEmpty(item.ImageUrl) ? $"/images/{item.Category?.Name?.ToLower()}/{item.ImageUrl}"
                                                     : "/images/no-image.png")"
                                     class="card-img-top" style="height: 180px; object-fit: cover;" alt="@item.Title"
                                     onerror="this.src='https://via.placeholder.com/400x250?text=Property+Image';" />
                                <span class="badge bg-primary position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill">
                                    €@item.Price
                                </span>
                            </div>

                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div>
                                    <h5 class="card-title fw-bold text-truncate mb-1">@item.Title</h5>
                                    <p class="text-muted small mb-3">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>@(item.City ?? "N/A")
                                    </p>
                                </div>

                                <a asp-controller="Property" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary rounded-3 w-100">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <i class="bi bi-houses text-muted display-1"></i>
                    <p class="text-muted mt-2">Nuk keni asnjë pronë të regjistruar akoma.</p>
                </div>
            }
        </div>
    </main>
</div>