<div class="container my-5">

    <h1 class="mb-5">

        Admin Dashboard

    </h1>

    <div class="row">

        <div class="col-md-4 mb-4">

            <div class="dashboard-card bg-blue">

                <h2>120</h2>

                <p>Total Properties</p>

            </div>

        </div>

        <div class="col-md-4 mb-4">

            <div class="dashboard-card bg-green">

                <h2>50</h2>

                <p>Total Users</p>

            </div>

        </div>

        <div class="col-md-4 mb-4">

            <div class="dashboard-card bg-orange">

                <h2>15</h2>

                <p>Categories</p>

            </div>

        </div>

    </div>

    <div class="card shadow-lg border-0 mt-5 p-4">

        <h3 class="mb-4">

            Property Statistics

        </h3>

        <canvas id="propertyChart"></canvas>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    const ctx =
        document.getElementById('propertyChart');

    new Chart(ctx,
    {
        type: 'bar',

        data:
        {
            labels:
            [
                'Apartments',
                'Villas',
                'Houses',
                'Offices'
            ],

            datasets:
            [{
                label: 'Properties',

                data: [12, 19, 8, 5],

                backgroundColor:
                [
                    '#0ea5e9',
                    '#10b981',
                    '#f59e0b',
                    '#ef4444'
                ]
            }]
        }
    });

</script>


