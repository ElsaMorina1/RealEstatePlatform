@model Microsoft.AspNetCore.Identity.IdentityUser
@{
    ViewData["Title"] = "User Profile";
}

<div class="container py-4">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 bg-white">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto fs-1 fw-bold mb-3" style="width: 100px; height: 100px;">
                    @(Model?.UserName?.Substring(0, 1).ToUpper() ?? "U")
                </div>
                <h4 class="fw-bold mb-1">@Model?.UserName</h4>
                <p class="text-muted small mb-3">@Model?.Email</p>
                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">Active Account</span>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h4 class="fw-bold mb-4"><i class="bi bi-person-gear text-primary me-2"></i>Account Details</h4>
                <form asp-action="Profile" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Username</label>
                        <input type="text" class="form-control rounded-3" value="@Model?.UserName" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <input type="email" class="form-control rounded-3" value="@Model?.Email" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone Number</label>
                        <input type="text" class="form-control rounded-3" value="@Model?.PhoneNumber" placeholder="Add phone number..." />
                    </div>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 mt-2">
                        <i class="bi bi-check-lg me-1"></i> Save Changes
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>