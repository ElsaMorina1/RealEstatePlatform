<div class="container my-5">

    <div class="row">

        <div class="col-md-6">

            <img src="/images/contact.jpg"
                 class="img-fluid rounded shadow" />

        </div>

        <div class="col-md-6">

            <div class="card shadow border-0 p-5">

                <h2 class="mb-4">
                    Contact Us
                </h2>

                <form method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">

                        <input type="text"
                               name="name"
                               class="form-control"
                               placeholder="Your Name"
                               required />

                    </div>

                    <div class="mb-3">

                        <input type="email"
                               name="email"
                               class="form-control"
                               placeholder="Your Email"
                               required />

                    </div>

                    <div class="mb-3">

                        <textarea name="message"
                                  rows="5"
                                  class="form-control"
                                  placeholder="Message"
                                  required></textarea>

                    </div>

                    <button class="auth-btn">

                        Send Message

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

