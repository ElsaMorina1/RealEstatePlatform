@model IEnumerable<RealEstatePlatform.Models.Property>
@{
    ViewData["Title"] = "My Favorites";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0"><i class="bi bi-heart-fill text-danger me-2"></i>Saved Favorites</h2>
            <p class="text-muted m-0">Properties you have saved for later.</p>
        </div>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 position-relative">
                        <img src="@(!string.IsNullOrEmpty(item.ImageUrl) ? "/uploads/" + item.ImageUrl : "https://via.placeholder.com/400x250")"
                             class="card-img-top" style="height: 180px; object-fit: cover;" alt="@item.Title" />

                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                            <div>
                                <h5 class="card-title fw-bold text-truncate mb-1">@item.Title</h5>
                                <p class="text-muted small mb-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@item.City</p>
                                <p class="fw-bold text-primary fs-5 mb-3">€@item.Price</p>
                            </div>

                            <div class="d-flex gap-2">
                                <a asp-controller="Property" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary rounded-3 w-100">View</a>
                                <button class="btn btn-outline-danger rounded-3" title="Remove"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm">
                <i class="bi bi-heartbreak text-muted display-3"></i>
                <h5 class="fw-bold mt-3">No Favorites Yet</h5>
                <p class="text-muted">You haven't added any properties to your favorites list.</p>
                <a asp-controller="Property" asp-action="Index" class="btn btn-primary rounded-pill px-4">Browse Properties</a>
            </div>
        }
    </div>
</div>
