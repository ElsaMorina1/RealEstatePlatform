@model IEnumerable<RealEstatePlatform.Models.ApplicationUser>

<div class="container my-5">

    <h2 class="mb-4">

        System Users

    </h2>

    <table class="table table-striped">

        <thead>

            <tr>

                <th>Full Name</th>
                <th>Email</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var user in Model)
            {
                <tr>

                    <td>@user.FullName</td>
                    <td>@user.Email</td>

                </tr>
            }

        </tbody>

    </table>

</div>